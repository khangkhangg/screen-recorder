<Window
    x:Class="ScreenRecorder.App.BarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Screen Recorder">
    <Border x:Name="Root" Padding="6" CornerRadius="14" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="ContextModeItem" Click="Mini_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="ContextSettingsItem" Text="Settings" Click="Settings_Click" />
                <MenuFlyoutItem Text="Quit" Click="Quit_Click" />
            </MenuFlyout>
        </Border.ContextFlyout>
        <Border.Resources>
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="Segment" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="Divider" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
        </Border.Resources>
        <Grid>
            <Border x:Name="SegmentProbe" Visibility="Collapsed" Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlElevationBorderBrush}" />
        <StackPanel x:Name="Bar" Orientation="Horizontal" Spacing="4">
                <Border Width="20" Height="40" Background="Transparent" ToolTipService.ToolTip="Drag to move" PointerPressed="Grip_PointerPressed">
                    <FontIcon Glyph="&#xE784;" FontSize="16" />
                </Border>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <StaticResource x:Key="ButtonBackground" ResourceKey="SystemFillColorCriticalBrush" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SystemFillColorCriticalBrush" />
                        <StaticResource x:Key="ButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                    </StackPanel.Resources>
                    <Button x:Name="RecordButton" Style="{StaticResource IconButton}" Click="Record_Click"
                            ToolTipService.ToolTip="Record" AutomationProperties.Name="Record">
                        <FontIcon x:Name="RecordIcon" Glyph="&#xE7C8;" FontSize="16" />
                    </Button>
                    <Button x:Name="StopButton" Visibility="Collapsed" Style="{StaticResource IconButton}" Click="Stop_Click"
                            ToolTipService.ToolTip="Stop" AutomationProperties.Name="Stop">
                        <FontIcon Glyph="&#xE71A;" FontSize="16" />
                    </Button>
                </StackPanel>
                <Button x:Name="PauseButton" Visibility="Collapsed" Style="{StaticResource IconButton}" Click="Pause_Click"
                        ToolTipService.ToolTip="Pause" AutomationProperties.Name="Pause">
                    <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="16" />
                </Button>
                <TextBlock x:Name="CountdownText" Visibility="Collapsed" FontSize="16" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TimerText" Visibility="Collapsed" Text="0:00" FontSize="14" Margin="6,0" VerticalAlignment="Center"
                           AutomationProperties.Name="Recording time" />
                <TextBlock x:Name="FpsText" Visibility="Collapsed" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           ToolTipService.ToolTip="Screens larger than 2560 x 1440 record at 30 frames per second." />
                <Button x:Name="ScreenshotButton" Style="{StaticResource IconButton}" Click="Screenshot_Click"
                        ToolTipService.ToolTip="Screenshot" AutomationProperties.Name="Screenshot">
                    <FontIcon Glyph="&#xE722;" FontSize="16" />
                </Button>
                <Button x:Name="MiniTargetButton" Visibility="Collapsed" Style="{StaticResource IconButton}" Click="MiniTarget_Click" AutomationProperties.Name="Capture target">
                    <FontIcon x:Name="MiniTargetIcon" Glyph="&#xE7F4;" FontSize="16" />
                </Button>
                <Border x:Name="SourceSeparator" Style="{StaticResource Divider}" />
                <Border x:Name="SourceSwitch" Padding="2" CornerRadius="10" VerticalAlignment="Center"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="DesktopSegment" Style="{StaticResource Segment}" Click="Desktop_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                                <TextBlock Text="Desktop" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="WindowSegment" Style="{StaticResource Segment}" Click="Window_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE737;" FontSize="14" />
                                <TextBlock Text="Window" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RegionSegment" Style="{StaticResource Segment}" Click="Region_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7A8;" FontSize="14" />
                                <TextBlock Text="Region" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border x:Name="ToggleSeparator" Style="{StaticResource Divider}" />
                <ToggleButton x:Name="CameraToggle" Style="{StaticResource IconToggle}" Click="CameraToggle_Click" ToolTipService.ToolTip="Camera">
                    <FontIcon Glyph="&#xE714;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="LogoToggle" Style="{StaticResource IconToggle}" Click="LogoToggle_Click" ToolTipService.ToolTip="Logo">
                    <FontIcon Glyph="&#xE91B;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="MicToggle" Style="{StaticResource IconToggle}" Click="MicToggle_Click" ToolTipService.ToolTip="Microphone">
                    <FontIcon Glyph="&#xE720;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="SoundToggle" Style="{StaticResource IconToggle}" Click="SoundToggle_Click" ToolTipService.ToolTip="Computer sound">
                    <FontIcon Glyph="&#xE767;" FontSize="16" />
                </ToggleButton>
                <Button x:Name="LiveScreenshotButton" Visibility="Collapsed" Style="{StaticResource IconButton}" Click="Screenshot_Click"
                        ToolTipService.ToolTip="Screenshot" AutomationProperties.Name="Screenshot">
                    <FontIcon x:Name="LiveScreenshotIcon" Glyph="&#xE722;" FontSize="16" />
                </Button>
                <Border x:Name="MoreSeparator" Style="{StaticResource Divider}" />
                <Button x:Name="MoreButton" Style="{StaticResource IconButton}" ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Camera shape" IsEnabled="False" />
                            <RadioMenuFlyoutItem x:Name="CircleItem" Text="Circle" GroupName="Shape" Tag="Circle" Click="Shape_Click" />
                            <RadioMenuFlyoutItem x:Name="RoundedSquareItem" Text="Rounded square" GroupName="Shape" Tag="RoundedSquare" Click="Shape_Click" />
                            <RadioMenuFlyoutItem x:Name="SquareItem" Text="Square" GroupName="Shape" Tag="Square" Click="Shape_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Choose logo" Click="PickLogo_Click" />
                            <MenuFlyoutItem x:Name="RemoveLogoItem" Text="Remove logo" Click="RemoveLogo_Click" />
                            <MenuFlyoutItem Text="Open recordings folder" Click="OpenFolder_Click" />
                            <MenuFlyoutItem x:Name="MoreModeItem" Click="Mini_Click" />
                            <MenuFlyoutItem Text="Settings" Click="Settings_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Quit" Click="Quit_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="MiniButton" Style="{StaticResource IconButton}" Click="Mini_Click">
                    <FontIcon x:Name="MiniIcon" Glyph="&#xE76B;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
