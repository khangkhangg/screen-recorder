<Window
    x:Class="ScreenRecorder.App.BarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Screen Recorder">
    <Border x:Name="Root" Padding="6" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Border Background="Transparent" Padding="4,0" ToolTipService.ToolTip="Drag to move"
                    PointerPressed="Grip_PointerPressed">
                <FontIcon Glyph="&#xE784;" FontSize="16" VerticalAlignment="Center" />
            </Border>

            <DropDownButton x:Name="TargetButton" Height="36" ToolTipService.ToolTip="What to capture"
                            AutomationProperties.Name="What to capture">
                <TextBlock x:Name="TargetText" Text="Desktop" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="TargetMenu" Placement="Bottom" Opening="TargetMenu_Opening" />
                </DropDownButton.Flyout>
            </DropDownButton>

            <AppBarSeparator />

            <ToggleButton x:Name="CameraToggle" Width="40" Height="36" Click="CameraToggle_Click"
                          ToolTipService.ToolTip="Camera" AutomationProperties.Name="Camera">
                <FontIcon Glyph="&#xE714;" FontSize="16" />
            </ToggleButton>
            <ToggleButton x:Name="MicToggle" Width="40" Height="36" Click="MicToggle_Click"
                          ToolTipService.ToolTip="Microphone" AutomationProperties.Name="Microphone">
                <FontIcon Glyph="&#xE720;" FontSize="16" />
            </ToggleButton>
            <ToggleButton x:Name="SoundToggle" Width="40" Height="36" Click="SoundToggle_Click"
                          ToolTipService.ToolTip="Computer sound" AutomationProperties.Name="Computer sound">
                <FontIcon Glyph="&#xE767;" FontSize="16" />
            </ToggleButton>
            <DropDownButton Height="36" ToolTipService.ToolTip="Camera shape" AutomationProperties.Name="Camera shape">
                <FontIcon Glyph="&#xEA3A;" FontSize="16" />
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <RadioMenuFlyoutItem x:Name="CircleItem" Text="Circle" GroupName="Shape" Tag="Circle" Click="Shape_Click" />
                        <RadioMenuFlyoutItem x:Name="RoundedSquareItem" Text="Rounded square" GroupName="Shape" Tag="RoundedSquare" Click="Shape_Click" />
                        <RadioMenuFlyoutItem x:Name="SquareItem" Text="Square" GroupName="Shape" Tag="Square" Click="Shape_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <DropDownButton x:Name="LogoButton" Height="36" ToolTipService.ToolTip="Logo" AutomationProperties.Name="Logo">
                <FontIcon Glyph="&#xE91B;" FontSize="16" />
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Pick a PNG or JPG file" Click="PickLogo_Click" />
                        <MenuFlyoutItem x:Name="RemoveLogoItem" Text="Remove logo" Click="RemoveLogo_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <AppBarSeparator />

            <Button x:Name="RecordButton" Width="40" Height="36" Click="Record_Click"
                    ToolTipService.ToolTip="Record" AutomationProperties.Name="Record">
                <Grid>
                    <FontIcon x:Name="RecordIcon" Glyph="&#xE7C8;" FontSize="16" />
                    <TextBlock x:Name="CountdownText" Visibility="Collapsed" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <TextBlock x:Name="TimerText" Visibility="Collapsed" Text="0:00" FontSize="14" Margin="6,0"
                       VerticalAlignment="Center" AutomationProperties.Name="Recording time" />
            <TextBlock x:Name="FpsText" Visibility="Collapsed" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                       ToolTipService.ToolTip="Screens larger than 2560 x 1440 record at 30 frames per second." />
            <Button x:Name="PauseButton" Visibility="Collapsed" Width="40" Height="36" Click="Pause_Click"
                    ToolTipService.ToolTip="Pause" AutomationProperties.Name="Pause">
                <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="16" />
            </Button>
            <Button x:Name="StopButton" Visibility="Collapsed" Width="40" Height="36" Click="Stop_Click"
                    ToolTipService.ToolTip="Stop" AutomationProperties.Name="Stop">
                <FontIcon Glyph="&#xE71A;" FontSize="16" />
            </Button>
            <Button x:Name="ScreenshotButton" Width="40" Height="36" Click="Screenshot_Click"
                    ToolTipService.ToolTip="Screenshot" AutomationProperties.Name="Screenshot">
                <FontIcon Glyph="&#xE722;" FontSize="16" />
            </Button>
            <Button x:Name="SettingsButton" Width="40" Height="36" Click="Settings_Click"
                    ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </StackPanel>
    </Border>
</Window>
