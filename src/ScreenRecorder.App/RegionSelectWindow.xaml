<Window
    x:Class="ScreenRecorder.App.RegionSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenRecorder.App"
    Title="Select a region">
    <local:CrossCursorControl x:Name="Root" IsTabStop="True"
                AutomationProperties.Name="Drag to select a region, press Escape to cancel"
                PointerPressed="Root_PointerPressed" PointerMoved="Root_PointerMoved"
                PointerReleased="Root_PointerReleased" KeyDown="Root_KeyDown">
        <!-- UserControl has no template to draw its own Background, so this Grid paints the dim and takes the pointer -->
        <Grid Background="Black" />
    </local:CrossCursorControl>
</Window>
