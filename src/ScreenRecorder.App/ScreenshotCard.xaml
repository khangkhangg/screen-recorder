<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenRecorder.App.ScreenshotCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Screenshot">
    <Border x:Name="Root" Padding="10" Background="Transparent" PointerEntered="Root_PointerEntered" PointerExited="Root_PointerExited" KeyDown="Root_KeyDown">
        <Border.Resources>
            <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </Border.Resources>
        <StackPanel Spacing="8">
            <Grid Width="280" Height="150" CornerRadius="8" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                <Image x:Name="Thumb" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Width="28" Height="28" Padding="0" CornerRadius="6"
                        Click="Close_Click" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6" Height="20">
                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
            </StackPanel>
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource Action}" Click="Open_Click" ToolTipService.ToolTip="Open in the default app" AutomationProperties.Name="Open">
                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE8A7;" FontSize="16" /><TextBlock Text="Open" Style="{StaticResource Label}" /></StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource Action}" Click="Copy_Click" ToolTipService.ToolTip="Copy the picture" AutomationProperties.Name="Copy">
                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE8C8;" FontSize="16" /><TextBlock Text="Copy" Style="{StaticResource Label}" /></StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource Action}" Click="Share_Click" ToolTipService.ToolTip="Share the picture" AutomationProperties.Name="Share">
                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE72D;" FontSize="16" /><TextBlock Text="Share" Style="{StaticResource Label}" /></StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource Action}" Click="Crop_Click" ToolTipService.ToolTip="Crop and save a copy" AutomationProperties.Name="Crop">
                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE7A8;" FontSize="16" /><TextBlock Text="Crop" Style="{StaticResource Label}" /></StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource Action}" Click="Delete_Click" ToolTipService.ToolTip="Move to the Recycle Bin" AutomationProperties.Name="Delete">
                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE74D;" FontSize="16" /><TextBlock Text="Delete" Style="{StaticResource Label}" /></StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
