<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenRecorder.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">
    <ScrollViewer x:Name="Root">
        <StackPanel Width="520" Padding="24,8,24,24" Spacing="4">
            <StackPanel.Resources>
                <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                    <Setter Property="Margin" Value="0,16,0,4" />
                </Style>
                <Style x:Key="Row" TargetType="Grid">
                    <Setter Property="Padding" Value="16,12" />
                    <Setter Property="ColumnSpacing" Value="16" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                </Style>
                <Style x:Key="Helper" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
                <Style x:Key="Error" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    <Setter Property="Margin" Value="16,0,0,4" />
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </StackPanel.Resources>

            <TextBlock Text="Recording" Style="{StaticResource Heading}" />
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Save to" />
                    <TextBlock x:Name="FolderText" Style="{StaticResource Helper}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <Button Grid.Column="1" Content="Change" Click="Folder_Click" VerticalAlignment="Center"
                        AutomationProperties.Name="Change save folder" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Frame rate" />
                    <TextBlock Text="Screens above 2560 x 1440 always use 30" Style="{StaticResource Helper}" />
                </StackPanel>
                <ComboBox x:Name="FrameRateBox" Grid.Column="1" Width="100" VerticalAlignment="Center"
                          SelectionChanged="FrameRate_Changed" AutomationProperties.Name="Frame rate">
                    <x:String>30</x:String>
                    <x:String>60</x:String>
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Countdown before recording" />
                    <TextBlock Text="3 seconds" Style="{StaticResource Helper}" />
                </StackPanel>
                <ToggleSwitch x:Name="CountdownSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                              Toggled="Countdown_Toggled" AutomationProperties.Name="Countdown before recording" />
            </Grid>

            <TextBlock Text="Devices" Style="{StaticResource Heading}" />
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Camera" VerticalAlignment="Center" />
                <ComboBox x:Name="WebcamBox" Grid.Column="1" Width="220" SelectionChanged="Webcam_Changed" AutomationProperties.Name="Camera" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Microphone" VerticalAlignment="Center" />
                <ComboBox x:Name="MicBox" Grid.Column="1" Width="220" SelectionChanged="Mic_Changed" AutomationProperties.Name="Microphone" />
            </Grid>

            <TextBlock Text="Shortcuts" Style="{StaticResource Heading}" />
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start or stop recording" />
                    <TextBlock Text="Click, then press the new keys" Style="{StaticResource Helper}" />
                </StackPanel>
                <TextBox x:Name="RecordHotkeyBox" Grid.Column="1" Width="180" VerticalAlignment="Center" IsReadOnly="True"
                         PreviewKeyDown="Hotkey_PreviewKeyDown" GotFocus="Hotkey_GotFocus" LostFocus="Hotkey_LostFocus"
                         AutomationProperties.Name="Start or stop recording" />
            </Grid>
            <TextBlock x:Name="RecordHotkeyError" Style="{StaticResource Error}" Text="This hotkey is used by another app." />
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Take a screenshot" />
                    <TextBlock Text="Click, then press the new keys" Style="{StaticResource Helper}" />
                </StackPanel>
                <TextBox x:Name="ScreenshotHotkeyBox" Grid.Column="1" Width="180" VerticalAlignment="Center" IsReadOnly="True"
                         PreviewKeyDown="Hotkey_PreviewKeyDown" GotFocus="Hotkey_GotFocus" LostFocus="Hotkey_LostFocus"
                         AutomationProperties.Name="Take a screenshot" />
            </Grid>
            <TextBlock x:Name="ScreenshotHotkeyError" Style="{StaticResource Error}" Text="This hotkey is used by another app." />
        </StackPanel>
    </ScrollViewer>
</Window>
