<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenRecorder.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">
    <ScrollViewer x:Name="Root">
        <StackPanel Padding="24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Output folder" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="FolderText" MaxWidth="280" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Content="Change" Click="Folder_Click" AutomationProperties.Name="Change output folder" />
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Record hotkey" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="RecordHotkeyBox" Width="180" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown" GotFocus="Hotkey_GotFocus" LostFocus="Hotkey_LostFocus"
                             AutomationProperties.Name="Record hotkey" />
                    <TextBlock x:Name="RecordHotkeyError" Visibility="Collapsed" Text="This hotkey is used by another app."
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Screenshot hotkey" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="ScreenshotHotkeyBox" Width="180" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown" GotFocus="Hotkey_GotFocus" LostFocus="Hotkey_LostFocus"
                             AutomationProperties.Name="Screenshot hotkey" />
                    <TextBlock x:Name="ScreenshotHotkeyError" Visibility="Collapsed" Text="This hotkey is used by another app."
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <ToggleSwitch x:Name="CountdownSwitch" Header="Countdown before recording" Toggled="Countdown_Toggled" />
            <ComboBox x:Name="FrameRateBox" Header="Frame rate" Width="180" SelectionChanged="FrameRate_Changed">
                <x:String>30</x:String>
                <x:String>60</x:String>
            </ComboBox>
            <ComboBox x:Name="WebcamBox" Header="Webcam" Width="280" SelectionChanged="Webcam_Changed" />
            <ComboBox x:Name="MicBox" Header="Microphone" Width="280" SelectionChanged="Mic_Changed" />
        </StackPanel>
    </ScrollViewer>
</Window>
