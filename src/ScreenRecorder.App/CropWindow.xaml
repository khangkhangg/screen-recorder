<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenRecorder.App.CropWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Crop screenshot">
    <Grid x:Name="Root" Padding="16" RowSpacing="16" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Canvas x:Name="View" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                PointerPressed="View_PointerPressed" PointerMoved="View_PointerMoved" PointerReleased="View_PointerReleased" PointerCaptureLost="View_PointerCaptureLost">
            <Image x:Name="Picture" Stretch="Fill" />
            <Path x:Name="Dim" Fill="#99000000" />
            <Rectangle x:Name="Outline" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" />
            <Rectangle x:Name="TopLeft" Width="12" Height="12" Fill="{ThemeResource AccentFillColorDefaultBrush}" Stroke="White" />
            <Rectangle x:Name="TopRight" Width="12" Height="12" Fill="{ThemeResource AccentFillColorDefaultBrush}" Stroke="White" />
            <Rectangle x:Name="BottomLeft" Width="12" Height="12" Fill="{ThemeResource AccentFillColorDefaultBrush}" Stroke="White" />
            <Rectangle x:Name="BottomRight" Width="12" Height="12" Fill="{ThemeResource AccentFillColorDefaultBrush}" Stroke="White" />
            <Border x:Name="SizeTag" Padding="6,2" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}">
                <TextBlock x:Name="SizeText" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
            </Border>
        </Canvas>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Height="32" Click="Cancel_Click" />
            <Button x:Name="SaveButton" Content="Save a copy" Height="32" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
