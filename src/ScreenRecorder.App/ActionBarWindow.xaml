<Window
    x:Class="ScreenRecorder.App.ActionBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Region actions">
    <Border x:Name="Root" Padding="6" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Border.Resources>
            <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
            </Style>
            <Style x:Key="AccentAction" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
            </Style>
        </Border.Resources>
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button x:Name="CopyButton" Style="{StaticResource AccentAction}" Click="Copy_Click"
                    ToolTipService.ToolTip="Copy to clipboard" AutomationProperties.Name="Copy to clipboard">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="CopyIcon" Glyph="&#xE73E;" FontSize="14" Visibility="Collapsed" />
                    <TextBlock x:Name="CopyText" Text="Copy" />
                </StackPanel>
            </Button>
            <Button x:Name="SaveButton" Style="{StaticResource Action}" Content="Save" Click="Save_Click"
                    ToolTipService.ToolTip="Save to your screenshots folder" AutomationProperties.Name="Save to your screenshots folder" />
            <Button x:Name="ShareButton" Style="{StaticResource Action}" Content="Share" Click="Share_Click"
                    ToolTipService.ToolTip="Share" AutomationProperties.Name="Share" />
            <Border Width="1" Height="20" Margin="4,0" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Button x:Name="RecordButton" Style="{StaticResource Action}" Click="Record_Click"
                    ToolTipService.ToolTip="Record this region" AutomationProperties.Name="Record this region">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="Record" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Style="{StaticResource Action}" Content="Cancel" Click="Cancel_Click"
                    ToolTipService.ToolTip="Cancel the selection" AutomationProperties.Name="Cancel the selection" />
        </StackPanel>
    </Border>
</Window>
